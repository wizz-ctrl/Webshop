# LocalLoop production environment variables.
# Copy to .env and fill in real values. See SETUP.md for step-by-step.

# ── Database (Postgres) ─────────────────────────────────────────
# Dev: SQLite (no setup). Prod: Neon Postgres (free tier).
DATABASE_URL="file:../.data/localloop.db"
# Production:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?pgbouncer=true&connection_limit=1"
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname"
# SHADOW_DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/shadow"

# ── Auth (NextAuth v5) ──────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Email magic links (Resend https://resend.com/, Mailgun, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@yourdomain.com"

# ── LLM Provider ───────────────────────────────────────────────
# Recommended: Google AI Studio (Gemini) — 1,500 RPD free.
# Get key at https://aistudio.google.com/apikey
OPENAI_API_KEY=""
OPENAI_API_BASE="https://generativelanguage.googleapis.com/v1beta/openai"
# Alternative: OpenRouter (paid, multi-model). Get key at https://openrouter.ai/keys
# OPENAI_API_BASE="https://openrouter.ai/api/v1"
# OPENROUTER_DEV_KEY="sk-or-..."
# Optional: Direct Anthropic fallback
# ANTHROPIC_API_KEY="sk-ant-..."

# ── Encryption (AES-256-GCM) ──────────────────────────────────
# Generate: openssl rand -base64 32
OPENROUTER_ENCRYPTION_KEY=""

# ── Vercel OAuth + Deploy ──────────────────────────────────────
# Register at https://vercel.com/dashboard/applications/new
VERCEL_CLIENT_ID=""
VERCEL_CLIENT_SECRET=""
VERCEL_REDIRECT_URI="https://YOUR-DOMAIN/api/vercel/oauth/callback"
VERCEL_API_BASE="https://api.vercel.com"

# ── Cloudflare R2 (site storage) ──────────────────────────────
# Create bucket at https://dash.cloudflare.com/R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="localloop-sites"
SITES_DIR=".data/sites"

# ── Upstash Redis (rate limit + pubsub + BullMQ) ──────────────
# Create at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# For BullMQ + pubsub (needs the redis:// URL, not the REST URL)
REDIS_URL=""

# ── Sentry (error tracking) ────────────────────────────────────
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ── PostHog (analytics) ────────────────────────────────────────
POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# ── Stripe (paid plans — Sprint 5) ─────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── App config ──────────────────────────────────────────────────
NODE_ENV="development"
LLM_FALLBACK_ENABLED="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
